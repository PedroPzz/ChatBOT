# -------- Configuração do chatbot --------
COMPANY_NAME=Sua Empresa
# Números que recebem notificação de novo lead, separados por vírgula (com DDI+DDD)
ADMIN_NUMBERS=5591999999999,5591988888888
WORKING_HOURS=Segunda a sexta, das 9h às 18h

# Onde salvar os leads coletados (padrão: ./data/leads.json)
LEADS_FILE=./data/leads.json

# Minutos de inatividade até a conversa voltar ao menu inicial
SESSION_TIMEOUT_MIN=15

# Porta para expor um healthcheck HTTP em /health (deixe em branco para desativar)
HEALTH_PORT=3000

# Caminho de um Chromium já instalado no servidor (recomendado em VPS/Docker).
# Deixe em branco para usar o Chromium baixado automaticamente pelo Puppeteer.
# Em Debian/Ubuntu, após "apt install chromium", normalmente é /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# -------- Variáveis de teste da biblioteca (não usadas pelo bot) --------
WWEBJS_TEST_REMOTE_ID=XXXXXXXXXX@c.us
WWEBJS_TEST_CLIENT_ID=authenticated
